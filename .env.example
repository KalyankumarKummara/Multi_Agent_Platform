# GitHub activity persistence targets the dedicated MultiAgentPlatform DB.
# Local development uses Windows Authentication through ODBC Driver 18.
GITHUB_ACTIVITY_DB_SERVER=localhost
GITHUB_ACTIVITY_DB_NAME=MultiAgentPlatform
GITHUB_ACTIVITY_DB_DRIVER=ODBC Driver 18 for SQL Server
GITHUB_ACTIVITY_DB_TRUST_SERVER_CERTIFICATE=yes

# Optional SQLAlchemy mssql+pyodbc URL override. Keep credentials out of this file.
# GITHUB_ACTIVITY_DATABASE_URL=

# Set to 1 only when intentionally running the local SQL Server integration test.
RUN_MSSQL_INTEGRATION_TESTS=0
